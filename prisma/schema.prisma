// important note:- already shifted everything form prisma to supabase this prisma is just for reference and if needed to use it later conside it not useful to change any prisma part or do not use prisma commands in anywhere for db changes!!!
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public"]
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String
  price       Int
  category    String
  inventory   Int
  lastUpdated DateTime  @default(now())
  imageUrl    String?
  images      Json?
  rating      Float?    @default(3.5)
  specs       Json?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  reviews     Review[]
  
  @@schema("public")
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  userId    String   @db.Uuid
  userName  String
  rating    Float
  comment   String
  createdAt DateTime @default(now())

  @@schema("public")
}

model Order {
  id             String   @id @default(uuid())
  userId         String   @db.Uuid
  accountName    String
  accountNumber  String
  phone          String
  address        String
  pin            String
  paymentMethod  String
  payment        Float
  orderStatus  String   @default("Order Placed")
  paymentResult  String?  // ✅ New column for Razorpay outcome
  createdAt      DateTime @default(now())
  products       Json
  shippingEvents Json?
  ishiddenforuser Boolean @default(false)
  isarchived      Boolean @default(false)
  ishiddenforadmin Boolean @default(false)
  isarchivedforadmin Boolean @default(false)

  @@schema("public")
}
